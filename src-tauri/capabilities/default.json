{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for all LyricFlow windows",
  "windows": [
    "main",
    "taskbar",
    "edge-glow",
    "wallpaper-hud"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "global-shortcut:default"
  ]
}
