{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricFlow",
  "version": "1.3.0",
  "identifier": "com.badghost.lyricflow",
  "build": {
    "frontendDist": "../src",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LyricFlow",
        "url": "index.html",
        "width": 780,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "shadow": false,
        "skipTaskbar": false
      },
      {
        "label": "taskbar",
        "title": "LyricFlow Taskbar",
        "url": "taskbar.html",
        "width": 450,
        "height": 42,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "edge-glow",
        "title": "LyricFlow Edge Glow",
        "url": "edge_glow.html",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOENDOEM3M0UyMTgyOTgKUldTWWdpRSt4OGlNNC8rU3NBSTN2SEVveHExdE5YN0VXWFFSbHNJN0FNcC8vU3pmWURNclU1UXcK",
      "endpoints": [
        "https://github.com/badghost001/LyricFlow/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
