{
  "name": "lyricflow",
  "version": "1.40.2",
  "description": "LyricFlow",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node -c src/renderer.js src/tauri-bridge.js src/modules/*.js && node tests/lyrics-plus.test.js && node tests/translation.test.js && node tests/island-timeout.test.js && node tests/share-card.test.js && node tests/color-extraction.test.js && node tests/progress-seek.test.js && node tests/island-ghost-mode.test.js",
    "build:win": "electron-builder --win",
    "publish": "electron-builder --win -p always",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [],
  "author": "badghost",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.badghost.lyricflow",
    "productName": "LyricFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "badghost001",
        "repo": "LyricFlow"
      }
    ],
    "copyright": "Copyright © 2026 badghost",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/*.ps1",
      "**/*.cs"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        "portable"
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LyricFlow"
    },
    "appx": {
      "identityName": "badghost.LyricFlow",
      "publisher": "CN=badghost",
      "publisherDisplayName": "badghost",
      "applicationId": "LyricFlow",
      "languages": [
        "en-US"
      ],
      "addAutoLaunchExtension": false
    },
    "files": [
      "main.js",
      "preload.js",
      "preload_taskbar.js",
      "src/**/*",
      "assets/**/*",
      "smtc_reader.ps1",
      "smtc_control.ps1",
      "smtc_controller.ps1",
      "wallpaper.ps1",
      "wallpaper_helper.cs",
      "preload_edge_glow.js"
    ]
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "md5": "^2.3.0",
    "pinyin-pro": "^3.28.1"
  }
}
